{
  "id": null,
  "uid": "jobmanageragent-system-metrics",
  "title": "JobManagerAgent System Metrics",
  "description": "CPU, memory, disk, network, and Python GC stats collected by JobManagerAgent's background metrics collector and scraped from GET /metrics.",
  "tags": ["jobmanageragent"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Target Up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"job-manager-agent\"}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Metrics Cache Age",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "time() - jobmanageragent_metrics_last_collected_timestamp_seconds" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 120 }
            ]
          }
        },
        "overrides": []
      },
      "description": "Time since the background collector last refreshed the cached gauges. Should stay close to METRICS_COLLECTION_INTERVAL_SECONDS; a high value means the collector thread stalled."
    },
    {
      "id": 3,
      "title": "CPU Cores",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "jobmanageragent_cpu_count" }
      ]
    },
    {
      "id": 4,
      "title": "Disk Path Usage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "jobmanageragent_disk_usage_percent" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "CPU Usage %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "jobmanageragent_cpu_usage_percent", "legendFormat": "CPU %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Memory Usage %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "jobmanageragent_memory_usage_percent", "legendFormat": "Memory %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Disk Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "jobmanageragent_disk_used_bytes", "legendFormat": "Used" },
        { "refId": "B", "expr": "jobmanageragent_disk_total_bytes", "legendFormat": "Total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Network Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(jobmanageragent_network_bytes_sent_total[5m])", "legendFormat": "Sent/s" },
        { "refId": "B", "expr": "rate(jobmanageragent_network_bytes_received_total[5m])", "legendFormat": "Received/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "GC Uncollectable Objects",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(python_gc_objects_uncollectable_total)" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "description": "Total objects across all generations that the collector found but could not free (usually a __del__/reference-cycle leak). Should stay at 0."
    },
    {
      "id": 10,
      "title": "GC Collections Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(python_gc_collections_total{generation=\"0\"}[5m])", "legendFormat": "Gen 0" },
        { "refId": "B", "expr": "rate(python_gc_collections_total{generation=\"1\"}[5m])", "legendFormat": "Gen 1" },
        { "refId": "C", "expr": "rate(python_gc_collections_total{generation=\"2\"}[5m])", "legendFormat": "Gen 2" }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "description": "How often gc runs a collection pass per generation. Gen 0 firing constantly is normal; a rising Gen 2 rate can indicate memory pressure."
    },
    {
      "id": 11,
      "title": "GC Objects Collected Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(python_gc_objects_collected_total{generation=\"0\"}[5m])", "legendFormat": "Gen 0" },
        { "refId": "B", "expr": "rate(python_gc_objects_collected_total{generation=\"1\"}[5m])", "legendFormat": "Gen 1" },
        { "refId": "C", "expr": "rate(python_gc_objects_collected_total{generation=\"2\"}[5m])", "legendFormat": "Gen 2" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "description": "Objects freed per second by generation, from the same reference-counting garbage collector."
    },
    {
      "id": 12,
      "title": "Guardrail Triggers (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(jobmanageragent_guardrails_triggered_total[1h]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "description": "Total guardrail blocks (output validation, prompt-injection screening, tool-usage violations) across all categories in the last hour."
    },
    {
      "id": 13,
      "title": "Guardrail Trigger Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (guardrail, category) (rate(jobmanageragent_guardrails_triggered_total[5m]))",
          "legendFormat": "{{guardrail}} ({{category}})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "description": "Guardrail triggers per second, broken out by guardrail name and category (output_validation, injection, tool_usage). See guardrail_triggers table (JobManagerAgent DB) for the per-incident audit trail."
    }
  ]
}
