TARGET_URL=https://www.workatastartup.com/companies?demographic=any&hasEquity=any&hasSalary=any&industry=any&interviewProcess=any&jobType=any&layout=list-compact&minExperience=1&role=eng&role_type=be&role_type=fs&sortBy=created_desc&tab=any&usVisaNotRequired=any
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/webscraper
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=webscraper:events
# Optional backward-compatible alias if you prefer this name instead of DATABASE_URL.
POSTGRES_URL=postgresql+psycopg://username:password@localhost:5432/webscraper
# Railway cron schedule now controls execution timing. The default config runs hourly in UTC.

# Comma-separated board slugs to scrape per source (see ats_scraper.py) -- set one of these to
# narrow a source down to a handful of companies (e.g. for local testing). Leave unset to scrape
# every slug in slugs/<source>_companies.json instead; if that file is also missing, falls back to
# one real example board so a first run works without any setup at all.
# GREENHOUSE_BOARD_SLUGS=stripe
# ASHBY_BOARD_SLUGS=ramp
# LEVER_BOARD_SLUGS=palantir

# Only Greenhouse/Ashby/Lever postings updated/published within this many hours are written --
# their list endpoints return each company's ENTIRE current catalog with no server-side date
# filter, so this is what keeps a run against slugs/*.json's thousands of companies from handing
# JobManagerAgent tens of thousands of jobs (and LLM calls) to work through. YC is unaffected --
# its scrape has always been one small filtered search page.
SCRAPE_RECENCY_HOURS=6

# job_listings rows from ashby/greenhouse/lever older than this many days are deleted at the end
# of every pipeline run (see dataWriter.purge_stale_jobs) -- a job outside the recency window above
# never gets re-written, so its updated_at freezes at ingestion time and just ages out. YC rows are
# never purged by this.
SCRAPE_RETENTION_DAYS=7

# Comma-separated, case-insensitive substring match against each job's title -- a Greenhouse/
# Ashby/Lever posting outside this list is never written at all, regardless of recency. Mirrors YC's
# own scrape already being pre-scoped to role=eng&role_type=be&role_type=fs via TARGET_URL above --
# the other three sources have no equivalent server-side filter, so this applies the same idea
# client-side. Default targets software engineering roles; override if your resume targets
# something else.
# SCRAPE_TITLE_KEYWORDS=engineer,engineering,developer,programmer,software,swe,sde,full stack,fullstack,full-stack,backend,back-end,frontend,front-end,devops,site reliability,sre,infrastructure,platform,machine learning,ml engineer,ai engineer,data engineer,data scientist

# Hard cap on how many jobs from ONE source get written per pipeline run, applied after the recency
# and keyword filters above -- a backstop against a single unusually active day still flooding
# job_listings regardless of how well those filters perform. Newest-matching jobs are kept first.
SCRAPE_MAX_JOBS_PER_SOURCE=25