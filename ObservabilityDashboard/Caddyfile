{
	auto_https off
	admin off
}

:{$PORT:8080} {
	log {
		output stdout
		format console
	}

	@observability_api {
		path /api/* /health
	}

	handle @observability_api {
		header X-Dashboard-Proxy "observability-api"
		reverse_proxy {$OBSERVABILITY_API_UPSTREAM}
	}

	handle {
		root * /usr/share/caddy
		encode gzip zstd
		try_files {path} /index.html
		file_server
	}
}