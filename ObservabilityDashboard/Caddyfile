{
	auto_https off
	admin off
}

:{$PORT:8080} {
	log {
		output stdout
		format console
	}

	handle /api/* {
		reverse_proxy {$OBSERVABILITY_API_UPSTREAM}
	}

	handle /health {
		reverse_proxy {$OBSERVABILITY_API_UPSTREAM}
	}

	root * /usr/share/caddy
	encode gzip zstd
	try_files {path} /index.html
	file_server
}