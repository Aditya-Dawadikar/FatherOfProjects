# Postgres backend store for the MLflow Tracking Server (experiments, runs, registered
# prompts/models). MLflow creates and migrates its own tables on first request, so it's safe
# to point this at the same Postgres instance WebScraper/JobDataServer use, or a dedicated
# database if you'd rather keep it isolated.
MLFLOW_BACKEND_STORE_URI=postgresql://username:password@localhost:5432/mlflow

# Where MLflow stores artifact files (model binaries, logged datasets). Not used by the
# prompt registry itself (prompts are metadata-only), but `mlflow server` requires a
# destination. Local disk is fine and is ephemeral on Railway between deploys; point at
# S3/GCS here if you start logging real run artifacts.
MLFLOW_ARTIFACT_ROOT=./mlruns

# Railway sets PORT automatically in production; default used for local runs.
PORT=5000

# MLflow 3.x rejects requests whose Host header isn't allowlisted (DNS-rebinding
# protection), defaulting to localhost + private IPs only. serve.py auto-fills this from
# Railway's own RAILWAY_PUBLIC_DOMAIN/RAILWAY_PRIVATE_DOMAIN env vars, so you usually don't
# need to set it manually. Set it explicitly (comma-separated, wildcards allowed, e.g.
# "mlflow.example.com,*.railway.internal") if you're using a custom domain or hitting
# "Invalid Host header" errors.
MLFLOW_ALLOWED_HOSTS=
