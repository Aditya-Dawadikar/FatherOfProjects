DATABASE_URL=
POSTGRES_URL=
JOB_TABLE_NAME=job_listings
# Table JobManagerAgent writes match scores to (see its shared/job_match_data.py) -- this service
# only reads it, via /matches and /jobs/matched, so it must match JobManagerAgent's own
# JOB_MATCH_TABLE_NAME for both services to see the same data.
JOB_MATCH_TABLE_NAME=job_matches
REDIS_URL=redis://localhost:6379/0
JOB_DATA_SERVER_REDIS_STREAM_NAME=jobdataserver:events