# Model to pull and serve on boot. Any tag from https://ollama.com/library works; llama3.1:8b
# is the default JobManagerAgent expects (see its LLM_PROVIDER=ollama / OLLAMA_MODEL vars).
OLLAMA_MODEL=llama3.1:8b

# Railway sets PORT automatically in production; default used for local runs. start.sh binds
# ollama to 0.0.0.0:$PORT (not the ollama default of 127.0.0.1:11434) so it's reachable from
# other services over Railway's private network.
PORT=11434
