{
	auto_https off
	admin off
	debug
}

(job_data_upstream) {
	reverse_proxy https://peaceful-dream-production-9540.up.railway.app {
		header_up Host peaceful-dream-production-9540.up.railway.app
	}
}

:{$PORT:8080} {
	log {
		output stdout
		format console
	}

	route {
		@job_data_api {
			path /health /jobs /jobs/*
		}

		handle @job_data_api {
			header X-Dashboard-Proxy "job-data-api"
			header X-Caddy-Route "root-api"
			header X-Job-Data-Upstream "https://peaceful-dream-production-9540.up.railway.app"
			import job_data_upstream
		}

		handle_path /api/* {
			header X-Dashboard-Proxy "job-data-api"
			header X-Caddy-Route "api-prefix"
			header X-Job-Data-Upstream "https://peaceful-dream-production-9540.up.railway.app"
			import job_data_upstream
		}

		handle {
			header X-Caddy-Route "spa-fallback"
			root * /usr/share/caddy
			encode gzip zstd
			try_files {path} /index.html
			file_server
		}
	}
}