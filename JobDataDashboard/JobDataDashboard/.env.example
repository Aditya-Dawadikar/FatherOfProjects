JOB_DATA_API_PROXY=http://localhost:8000
VITE_JOB_DATA_API_BASE_URL=

# JobManagerAgent's API (evals/sweep endpoints) -- default port matches JobManagerAgent's
# main.py PORT fallback (8080).
AGENT_API_PROXY=http://localhost:8080
VITE_AGENT_API_BASE_URL=

# Grafana dashboard iframe-embedded on Agent Vitals' System Metrics tab (AgentVitalsView.tsx).
# Leave unset to use the deployed Railway Grafana instance; only needed if you run Grafana
# somewhere else (e.g. Observability/'s local docker-compose stack at http://localhost:3001/d/...).
VITE_GRAFANA_DASHBOARD_URL=
