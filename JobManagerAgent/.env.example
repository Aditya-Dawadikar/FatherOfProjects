# Postgres holding job_listings (same database WebScraper/JobDataServer write to)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/webscraper
# Optional backward-compatible alias if you prefer this name instead of DATABASE_URL.
POSTGRES_URL=postgresql+psycopg://username:password@localhost:5432/webscraper
JOB_TABLE_NAME=job_listings
JOB_MATCH_TABLE_NAME=job_matches

# Redis (same instance WebScraper publishes pipeline_completed events to)
REDIS_URL=redis://localhost:6379/0
WEBSCRAPER_REDIS_STREAM_NAME=webscraper:events
JOB_MANAGER_REDIS_STREAM_NAME=jobmanageragent:events
JOB_MANAGER_CONSUMER_GROUP=jobmanageragent-group
JOB_MANAGER_CONSUMER_NAME=jobmanageragent-1

# Groq (https://console.groq.com) hosted Llama model
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# MLflow prompt registry tracking store. Local sqlite file for dev; point at a
# shared Postgres URL (e.g. postgresql://user:pass@host:5432/mlflow) in production
# so registered prompt versions persist across deploys.
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db

# Matching behavior
MATCH_THRESHOLD=70
MAX_JOBS_PER_CYCLE=25
