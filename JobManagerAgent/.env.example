# Postgres holding job_listings (same database WebScraper/JobDataServer write to)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/webscraper
# Optional backward-compatible alias if you prefer this name instead of DATABASE_URL.
POSTGRES_URL=postgresql+psycopg://username:password@localhost:5432/webscraper
JOB_TABLE_NAME=job_listings
JOB_MATCH_TABLE_NAME=job_matches

# Redis (same instance WebScraper publishes pipeline_completed events to)
REDIS_URL=redis://localhost:6379/0
WEBSCRAPER_REDIS_STREAM_NAME=webscraper:events
JOB_MANAGER_REDIS_STREAM_NAME=jobmanageragent:events
JOB_MANAGER_CONSUMER_GROUP=jobmanageragent-group
JOB_MANAGER_CONSUMER_NAME=jobmanageragent-1

# Groq (https://console.groq.com) hosted Llama model
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Seconds to wait between consecutive Groq calls within a single matching cycle, to stay
# under your plan's requests-per-minute limit. Default of 20s caps this at 3 calls/minute
# (60/20=3) to match a 3-requests-per-minute Groq plan; raise it if you're still hitting 429s,
# lower it only if your plan actually allows more.
GROQ_REQUEST_DELAY_SECONDS=20

# MLflow prompt registry. Local sqlite file for zero-config local dev; in production point
# this at the deployed MLflowServer service instead (its Railway internal address, e.g.
# http://mlflowserver.railway.internal:5000, or its public URL) so prompt versions are
# tracked centrally rather than in a per-instance local file.
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db

# Matching behavior
MATCH_THRESHOLD=70
MAX_JOBS_PER_CYCLE=25
