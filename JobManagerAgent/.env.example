# Postgres holding job_listings (same database WebScraper/JobDataServer write to)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/webscraper
# Optional backward-compatible alias if you prefer this name instead of DATABASE_URL.
POSTGRES_URL=postgresql+psycopg://username:password@localhost:5432/webscraper
JOB_TABLE_NAME=job_listings
JOB_MATCH_TABLE_NAME=job_matches

# Redis (same instance WebScraper publishes pipeline_completed events to)
REDIS_URL=redis://localhost:6379/0
WEBSCRAPER_REDIS_STREAM_NAME=webscraper:events
JOB_MANAGER_REDIS_STREAM_NAME=jobmanageragent:events
JOB_MANAGER_CONSUMER_GROUP=jobmanageragent-group
JOB_MANAGER_CONSUMER_NAME=jobmanageragent-1

# LLM provider is Gemini only.
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey). Used when LLM_PROVIDER=gemini. Pin a concrete
# version here rather than an alias like "gemini-flash-latest" -- MLflow logs this as the
# llm_model param/tag, and an alias that silently repoints underneath it would make run
# comparisons misleading. Older generations (e.g. gemini-2.5-*) may 404 as "no longer available
# to new users" depending on when your API key was created; if this model 404s, list what's
# actually available to your account with client.models.list() and pick a current one.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# If gemini-3.5-flash fails once, the agent marks it unhealthy and skips retrying it for this
# many seconds, calling gemini-3.6-flash directly during the cooldown window.
GEMINI_PRIMARY_MODEL_COOLDOWN_SECONDS=600

# Requests-per-minute budget per model, enforced by rate_limiter.py via a Redis sliding
# window before every real Gemini call (live cycles, backfill cycles, and offline evals all
# share this). Set these BELOW your actual quota shown at https://aistudio.google.com/rate-limit
# -- e.g. our free-tier gemini-3.5-flash quota is 5 RPM shared with another application on the
# same project, so this is set to 4 to always leave headroom for that other app.
LLM_RPM_CAP__GEMINI_3_5_FLASH=4
LLM_RPM_CAP__GEMINI_3_6_FLASH=4

# USD per 1M tokens, used only to estimate cost_usd/cost_per_successful_run in
# evals/run_tool_selection_eval.py (utils/llm_pricing.py). Defaults match
# ai.google.dev/gemini-api/docs/pricing as of writing -- override per-model if pricing has moved
# or a non-global region applies. Not required for live cycles or the job-match offline eval.
# LLM_INPUT_PRICE_PER_MILLION__GEMINI_3_5_FLASH=1.50
# LLM_OUTPUT_PRICE_PER_MILLION__GEMINI_3_5_FLASH=9.00
# LLM_INPUT_PRICE_PER_MILLION__GEMINI_3_6_FLASH=1.50
# LLM_OUTPUT_PRICE_PER_MILLION__GEMINI_3_6_FLASH=7.50

# MLflow prompt registry + experiment tracking endpoint. This is required and must point
# to a running MLflow Tracking Server (sqlite URIs are intentionally rejected).
# Locally, run `venv\Scripts\python serve.py` in MLflowServer/ and use its localhost URL
# below; in production point this at the deployed MLflowServer service's Railway internal
# address instead, e.g. http://mlflowserver.railway.internal:5000.
MLFLOW_TRACKING_URI=http://localhost:5000
# Publicly reachable MLflow UI URL, used only to build "view in MLflow" links (e.g. from
# JobDataDashboard's Agent Vitals tab) -- kept separate from MLFLOW_TRACKING_URI because in
# production that points at Railway's internal hostname, which a browser can't reach. Leave
# unset to omit these links entirely. Locally this is usually the same as MLFLOW_TRACKING_URI.
MLFLOW_UI_BASE_URL=http://localhost:5000
# Trace sampling ratio for MLflow Tracing (0.0-1.0). Keep at 1.0 so every cycle
# and per-job span is captured.
MLFLOW_TRACE_SAMPLING_RATIO=1.0
# Keep async trace logging enabled (default true). The agent/eval code explicitly
# flushes traces at cycle/eval boundaries for reliability.
MLFLOW_ENABLE_ASYNC_TRACE_LOGGING=true
# MLflow experiment that each matching cycle's run (params, per-job match scores, and
# cycle-level counts) is logged under.
MLFLOW_EXPERIMENT_NAME=job_matching
# Separate MLflow experiment for offline eval runs (evals/run_offline_eval.py) against a golden
# dataset -- kept apart from MLFLOW_EXPERIMENT_NAME since eval metrics (accuracy/precision/recall)
# aren't comparable to live-cycle counts.
MLFLOW_EVAL_EXPERIMENT_NAME=job_matching_evals
# Separate again for evals/run_tool_selection_eval.py, which scores the ReAct orchestrator's own
# tool-selection behavior against mocked tools -- a different metric shape (tool_selection_accuracy/
# tool_error_rate/call_volume_efficiency/plan_adherence/consistency_score/cost_per_successful_run)
# than either live-cycle counts or job-match accuracy.
MLFLOW_TOOL_EVAL_EXPERIMENT_NAME=job_matching_tool_evals

# Matching behavior. MAX_JOBS_PER_CYCLE is kept small (rather than e.g. 25) because the RPM
# budget above is now what limits real throughput -- a big batch would just tie up one cycle
# for many minutes without checking for new live-trigger events in between.
MATCH_THRESHOLD=70
MAX_JOBS_PER_CYCLE=5

# Logging sink for structured runtime logs (agent_logger.py). "console" (default) prints to
# stdout. Add a new sink class + registry entry in agent_logger.py to route logs elsewhere
# later (e.g. a Prometheus/Grafana log pipeline) and select it here -- no call-site changes.
LOG_SINK=console

# System metrics (integrations/metrics/) exposed at GET /metrics for Prometheus/Grafana --
# see the Observability/ folder at the repo root for the docker-compose stack that scrapes it.
# How often the background collector thread refreshes the cached CPU/memory/disk/network
# gauges; /metrics itself never triggers a fresh OS sample.
METRICS_COLLECTION_INTERVAL_SECONDS=15
# Filesystem path disk usage is sampled from. Leave unset to default to the current drive root
# (Path.cwd().anchor -- e.g. "C:\" locally, "/" in the Linux deployment).
# METRICS_DISK_PATH=/
